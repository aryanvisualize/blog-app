<h1>Edit Post</h1>

<form action="/edit/<%= post.id %>" method="POST">

    <label>Title</label>
    <input
        type="text"
        name="title"
        value="<%= post.title %>"
        required
    >

    <br><br>

    <label>Author</label>
    <input
        type="text"
        name="author"
        value="<%= post.author %>"
        required
    >

    <br><br>

    <label>Content</label>

    <textarea
        name="content"
        rows="8"
        cols="50"
        required
    ><%= post.content %></textarea>

    <br><br>

    <button type="submit">
        Update Post
    </button>

</form>
<%- include('partials/header') %>
<%- include('partials/navbar') %>
<section class="hero">
  <h1>Share Your Thoughts</h1>
  <p>
    Welcome to Blogify! Write, publish, and share your ideas with the world.
  </p>
  <a href="/create" class="btn">Create New Post</a>
</section>

<section class="posts">
    <h2>Recent Posts</h2>
    <% if (posts.length === 0) { %>
        <p>No posts yet. Start writing your first blog!</p>
    <% } else { %>

        <% posts.forEach(post => { %>
            <div class="post-card">
                <h3><%= post.title %></h3>
                <p><strong>Author:</strong> <%= post.author %></p>
                <p><%= post.content %></p>
                <small>
                    Posted on
                    <%= post.updatedAt.toLocaleString() %>
                </small>
                 <a href="/edit/<%= post.id %>">
                    <button>Edit</button>
                </a>
            </div>
        <% }) %>

    <% } %>
</section>
<%- include("partials/footer") %>
